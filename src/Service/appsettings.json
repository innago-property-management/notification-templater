{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ]
  },
  "valkey": "localhost:6379",
  "serviceName": "NotificationTemplaterService",
  "serviceVersion": "0.0.1",
  "otlpEndpoint": "http://localhost:14318/v1/traces",
  "publisherAmqp": {
    "address": {
      "host": "innago-prod-rabbitmq-cip-svc.innago-prod.svc",
      "port": "5672",
      "scheme": "AMQP",
      "path": "/",
      "user": "get from vault",
      "password": "get from vault"
    }
  }
}
